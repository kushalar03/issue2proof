# Optional for private deployments; the Render public workspace does not use a login token.
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
ISSUE2PROOF_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
ISSUE2PROOF_MODEL_ENGINEERING=nvidia/nemotron-3-super-120b-a12b
ISSUE2PROOF_MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b
ISSUE2PROOF_MODEL_CHALLENGER=moonshotai/Kimi-K2.7-Code
ISSUE2PROOF_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
ISSUE2PROOF_EMBEDDING_DIMENSIONS=1024
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_PROJECT_ID=
NEBIUS_SANDBOX_URL=https://api.tokenfactory.nebius.com/sandboxes
# Optional; defaults to the quickstart image. Pin an image UUID for reproducible runs.
NEBIUS_SANDBOX_IMAGE=python:3.12-slim
ISSUE2PROOF_DB=runs.sqlite3
ISSUE2PROOF_ACCESS_TOKEN=
# Optional restricted credential for external judges. Keep the administrator token private.
ISSUE2PROOF_JUDGE_TOKEN=
ISSUE2PROOF_CAPSULE_SIGNING_KEY=
# DOMAIN is required by the HTTPS Compose deployment.
DOMAIN=
ISSUE2PROOF_DAILY_BUDGET_USD=25
ISSUE2PROOF_TOTAL_BUDGET_USD=25
ISSUE2PROOF_PROTECTED_RESERVE_USD=0
ISSUE2PROOF_RETENTION_DAYS=7
ISSUE2PROOF_QUEUE_LIMIT=20
